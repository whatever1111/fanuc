<?xml version="1.0"?>
<!-- 
  Wrapper launch file for the Fanuc specific weld_state node.
  
  This node connects to the Fanuc robot controller to receive real-time
  welding status information from an EWM welding power source connected
  via fieldbus (Profinet/EthernetIP).
-->
<launch>
  <!-- IP of robot (or PC running simulation) -->
  <arg name="robot_ip" doc="IP of controller" />

  <!-- Port for welding state communication (default: 11002, same as robot_state) -->
  <arg name="robot_port" default="11002" doc="TCP port for welding state communication" />

  <!-- Load the byte-swapping version of weld_state if required -->
  <arg name="use_bswap" doc="If true, driver will byte-swap all incoming and outgoing data" />

  <!-- put them on the parameter server -->
  <param name="robot_ip_address" type="str" value="$(arg robot_ip)" />
  <param name="robot_port"       type="int" value="$(arg robot_port)" />

  <!-- load the correct version of the weld state node -->
  <node if="$(arg use_bswap)" name="weld_state" 
    pkg="fanuc_driver" type="weld_state_bswap" />
  <node unless="$(arg use_bswap)" name="weld_state" 
    pkg="fanuc_driver" type="weld_state" />
</launch> 