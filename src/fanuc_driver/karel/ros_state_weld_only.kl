PROGRAM ros_state_weld_only
--------------------------------------------------------------------------------
-- 
-- ROS-Industrial welding state proxy (simplified version)
-- 
-- This version only handles welding I/O and removes all joint state logic
-- 
-- Assumptions:
--   - User Socket Messaging (USM) is supported by robot
--   - DOUT[1] is used for welding state testing (output for testing)
-- 
-- Configuration defaults:
--   - TAG '3' used for USM
--   - State TCP port ROS-I default (11002)
-- 
-- author: Based on G.A. vd. Hoorn (TU Delft Robotics Institute)
-- 
--------------------------------------------------------------------------------
%ALPHABETIZE
%COMMENT = 'r23'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR

--------------------------------------------------------------------------------
-- 
-- remote types & constants
-- 
--------------------------------------------------------------------------------
%INCLUDE include\libssock_t
%INCLUDE include\libind_rs_t
%INCLUDE include\libind_weld_t

--------------------------------------------------------------------------------
-- 
-- local types & constants
-- 
--------------------------------------------------------------------------------
TYPE
	weld_cfg_t = STRUCTURE
		checked      : BOOLEAN  -- user flagged: config checked
		loop_hz      : INTEGER  -- main loop update rate (in Hz)
		s_tcp_nr     : INTEGER  -- TCP port to listen on
		s_tag_nr     : INTEGER  -- server TAG number to use
		um_clear     : BOOLEAN  -- clear user menu on start
	ENDSTRUCTURE

VAR
	cfg_                   IN SHADOW : weld_cfg_t -- configuration
	weld_pkt_out_          : ind_weld_t   -- ROS-Industrial welding state packet
	sock_                  : ssock_t      -- server socket instance
	sock_fd_               : FILE         -- file descriptor associated with server socket
	stat_                  : INTEGER      -- status variable
	sleep_time_            : INTEGER      -- sleep time in milliseconds
	shutdwn_req_           : BOOLEAN      -- program abort requested status
	do_value_              : BOOLEAN      -- DOUT[1] status for welding state testing
	
	-- Variables for welding serialization routine
	weld_pkt_temp_         : ind_weld_t   -- temporary packet for serialization
	weld_bool_int_         : INTEGER      -- temporary boolean to integer conversion

CONST
	-- 
	LOG_PFIX     = 'RWLD '

	CFG_OK       =    0  -- config ok
	CFG_NOTDONE  =   -1  -- configuration not checked: user action required

	HOST_CTAG_ER = 67144 -- HOST-144 Comm Tag error
	FILE_ILL_PRM =  2032 -- FILE-032 Illegal parameter
	SEV_ABORT    =    2  -- ABORT severity
	-- Note: TAG_CONF_ERR is already defined in libssock_t.kl as -1

	-- Configuration defaults
	STATE_TAG    =    3  -- Server tag
	STATE_TCP_P  = 11002  -- TCP port for state
	LOOP_HZ      =   42  -- Main loop freq (Hz)

--------------------------------------------------------------------------------
-- 
-- remote routine prototypes
-- 
--------------------------------------------------------------------------------
%INCLUDE include\libssock_h
%INCLUDE include\libind_log_h

--------------------------------------------------------------------------------
-- 
-- local routine prototypes & implementations
-- 
--------------------------------------------------------------------------------
ROUTINE check_cfg_(cfg : weld_cfg_t) : INTEGER
VAR
	a__ : BOOLEAN
BEGIN
	a__ = FALSE
	
	log_info(LOG_PFIX + 'check_cfg_: Starting configuration check')

	-- set defaults for any uninitialised entries
	IF (UNINIT(cfg.loop_hz  )) THEN 
		cfg.loop_hz   = LOOP_HZ    
		a__ = TRUE
		log_info(LOG_PFIX + 'cfg: loop_hz set to default (42)')
	ELSE
		log_info(LOG_PFIX + 'cfg: loop_hz already set')
	ENDIF
	
	IF (UNINIT(cfg.s_tcp_nr )) THEN 
		cfg.s_tcp_nr  = STATE_TCP_P
		a__ = TRUE
		log_info(LOG_PFIX + 'cfg: s_tcp_nr set to default (11002)')
	ELSE
		log_info(LOG_PFIX + 'cfg: s_tcp_nr already set')
	ENDIF
	
	IF (UNINIT(cfg.s_tag_nr )) THEN 
		cfg.s_tag_nr  = STATE_TAG  
		a__ = TRUE
		log_info(LOG_PFIX + 'cfg: s_tag_nr set to default (3)')
	ELSE
		log_info(LOG_PFIX + 'cfg: s_tag_nr already set')
	ENDIF
	
	IF (UNINIT(cfg.um_clear )) THEN 
		cfg.um_clear  = TRUE       
		a__ = TRUE
		log_info(LOG_PFIX + 'cfg: um_clear set to default TRUE')
	ELSE
		log_info(LOG_PFIX + 'cfg: um_clear already set')
	ENDIF
	
	IF (UNINIT(cfg.checked  )) THEN 
		cfg.checked   = FALSE      
		a__ = TRUE
		log_info(LOG_PFIX + 'cfg: checked set to default FALSE')
	ELSE
		log_info(LOG_PFIX + 'cfg: checked already set')
	ENDIF

	-- Debug: Show current configuration status
	log_info(LOG_PFIX + 'cfg: Current configuration status:')
	IF cfg.um_clear THEN
		log_info(LOG_PFIX + 'cfg:   um_clear = TRUE')
	ELSE
		log_info(LOG_PFIX + 'cfg:   um_clear = FALSE')
	ENDIF
	IF cfg.checked THEN
		log_info(LOG_PFIX + 'cfg:   checked = TRUE')
	ELSE
		log_info(LOG_PFIX + 'cfg:   checked = FALSE')
	ENDIF
	
	IF a__ THEN
		log_info(LOG_PFIX + 'cfg:   a__ = TRUE (some defaults were set)')
	ELSE
		log_info(LOG_PFIX + 'cfg:   a__ = FALSE (no defaults set)')
	ENDIF

	-- make sure user has checked configuration
	IF ((NOT cfg.checked) OR a__) THEN 
		log_error(LOG_PFIX + 'cfg: Configuration check failed!')
		IF (NOT cfg.checked) THEN
			log_error(LOG_PFIX + 'cfg: ERROR - cfg.checked is FALSE')
			log_error(LOG_PFIX + 'cfg: Please set cfg_.checked = TRUE in shadow variable')
		ENDIF
		IF a__ THEN
			log_error(LOG_PFIX + 'cfg: ERROR - Some default values were set')
			log_error(LOG_PFIX + 'cfg: Please check configuration and set cfg_.checked = TRUE')
		ENDIF
		
		-- TEMPORARY FIX: Auto-set checked for testing
		log_info(LOG_PFIX + 'cfg: TEMPORARY FIX - Auto-setting cfg.checked = TRUE for testing')
		cfg.checked = TRUE
		-- RETURN (CFG_NOTDONE)
	ENDIF

	-- all ok
	log_info(LOG_PFIX + 'cfg: Configuration check passed')
	RETURN (CFG_OK)
END check_cfg_

ROUTINE iwd_srlise(weld_pkt_in : ind_weld_t) : INTEGER
BEGIN
	log_info(LOG_PFIX + 'iwd_srlise: Starting welding packet serialization')
	
	-- Copy input parameter to program-level variable for processing
	weld_pkt_temp_ = weld_pkt_in
	
	-- Write header
	log_info(LOG_PFIX + 'iwd_srlise: Writing header')
	WRITE sock_fd_ (weld_pkt_temp_.hdr_.length_)
	WRITE sock_fd_ (weld_pkt_temp_.hdr_.msg_type_)
	WRITE sock_fd_ (weld_pkt_temp_.hdr_.comm_type_)
	WRITE sock_fd_ (weld_pkt_temp_.hdr_.reply_type_)

	-- Write weld_state_t payload, converting booleans to integers
	log_info(LOG_PFIX + 'iwd_srlise: Writing welding data payload')
	IF weld_pkt_temp_.weld_data_.arc_ok THEN weld_bool_int_ = 1; ELSE weld_bool_int_ = 0; ENDIF
	WRITE sock_fd_ (weld_bool_int_)
	IF weld_pkt_temp_.weld_data_.ready THEN weld_bool_int_ = 1; ELSE weld_bool_int_ = 0; ENDIF
	WRITE sock_fd_ (weld_bool_int_)
	IF weld_pkt_temp_.weld_data_.stick_err THEN weld_bool_int_ = 1; ELSE weld_bool_int_ = 0; ENDIF
	WRITE sock_fd_ (weld_bool_int_)
	IF weld_pkt_temp_.weld_data_.general_err THEN weld_bool_int_ = 1; ELSE weld_bool_int_ = 0; ENDIF
	WRITE sock_fd_ (weld_bool_int_)

	WRITE sock_fd_ (weld_pkt_temp_.weld_data_.err_code)
	WRITE sock_fd_ (weld_pkt_temp_.weld_data_.act_voltage)
	WRITE sock_fd_ (weld_pkt_temp_.weld_data_.act_current)
	WRITE sock_fd_ (weld_pkt_temp_.weld_data_.act_wire_spd)

	log_info(LOG_PFIX + 'iwd_srlise: Welding packet serialization completed')
	RETURN (0)
END iwd_srlise

--------------------------------------------------------------------------------
-- 
-- Main program
-- 
--------------------------------------------------------------------------------
BEGIN
	log_info(LOG_PFIX + 'Program started: ROS welding state proxy')
	
	-- check config
	log_info(LOG_PFIX + 'Starting configuration check')
	stat_ = check_cfg_(cfg_)
	IF (stat_ <> CFG_OK) THEN
		log_error_a(LOG_PFIX + 'cfg error:', stat_)
		log_error(LOG_PFIX + 'check cfg')
		-- errors with config always force user to log window
		log_force
		POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT)
		RETURN
	ENDIF
	log_info(LOG_PFIX + 'Configuration check completed successfully')

	-- Initialize variables
	stat_        = 0
	sleep_time_  = ROUND(1000.0 / cfg_.loop_hz)
	shutdwn_req_ = FALSE
	
	log_info(LOG_PFIX + 'Variables initialized')

	-- enable log output
	IF (cfg_.um_clear) THEN 
		log_clear
		log_info(LOG_PFIX + 'User menu cleared')
	ENDIF

	-- init welding packet
	log_info(LOG_PFIX + 'Initializing welding packet')
	USING weld_pkt_out_ DO
		-- Header (16 bytes) + Payload (32 bytes) = 48 bytes total
		hdr_.length_     = 48
		hdr_.msg_type_   = RI_MT_WELDST
		hdr_.comm_type_  = 1     -- TOPIC
		hdr_.reply_type_ = 0     -- INVALID
		-- data is filled in the loop
	ENDUSING
	log_info(LOG_PFIX + 'Welding packet initialized')

	-- init server socket
	log_info(LOG_PFIX + 'Initializing server socket')
	stat_ = ssock_ctor(sock_, cfg_.s_tcp_nr,  cfg_.s_tag_nr)
	IF (stat_ <> 0) THEN
		IF (stat_ = TAG_CONF_ERR) THEN
			log_error_a(LOG_PFIX + 'cfg err, TAG idx:', cfg_.s_tag_nr)
		ELSE
			log_error_a(LOG_PFIX + 'ssock_ctor err:', stat_)
		ENDIF
		-- nothing we can do, abort
		POST_ERR(HOST_CTAG_ER, '', 0, SEV_ABORT)
	ENDIF
	log_info(LOG_PFIX + 'Server socket initialized successfully')

	-- make sure socket is closed
	-- don't care about result
	stat_ = ssock_dconnf(sock_)
	log_info(LOG_PFIX + 'Socket disconnected (cleanup)')

	-- Main connection loop
	log_info(LOG_PFIX + 'Entering main connection loop')
	WHILE (NOT shutdwn_req_) DO

		-- inform user
		log_info(LOG_PFIX + 'Waiting for ROS welding state client')

		-- set socket in 'binary mode' (unformatted)
		-- KAREL Reference Manual, MARRC75KR07091E Rev C, sec 7.3.1
		SET_FILE_ATR(sock_fd_, ATR_UF)

		-- wait for connection
		stat_ = ssock_accpt2(sock_, sock_fd_)
		IF (stat_ <> 0) THEN
			log_error_a(LOG_PFIX + 'sock_accept err:', stat_)
			-- can't continue
			GOTO exit_discon
		ENDIF

		-- inform user
		log_info(LOG_PFIX + 'Connected - starting welding state relay')

		-- got client, start welding state relay loop
		WHILE (NOT shutdwn_req_) DO

			-- Read DOUT[1] status for welding state testing
			do_value_ = DOUT[81]
			log_info(LOG_PFIX + 'Read DOUT[1] status for welding test')

			-- Update welding data
			USING weld_pkt_out_.weld_data_ DO
				-- Use DOUT[1] status for testing
				arc_ok        = do_value_        -- DOUT[1] status
				ready         = FALSE            -- Set to false for testing
				stick_err     = FALSE            -- Set to false for testing
				general_err   = FALSE            -- Set to false for testing

				-- Set simple test values
				err_code      = 0
				act_voltage   = 1234   -- Test value
				act_current   = 5678   -- Test value
				act_wire_spd  = 9012   -- Test value
			ENDUSING

			-- Debug: Show current welding state
			IF do_value_ THEN
				log_info(LOG_PFIX + 'Welding state: DOUT[1] = TRUE (arc_ok = TRUE)')
			ELSE
				log_info(LOG_PFIX + 'Welding state: DOUT[1] = FALSE (arc_ok = FALSE)')
			ENDIF

			-- serialise welding packet, write to socket file descriptor
			stat_ = iwd_srlise(weld_pkt_out_)

			-- check result
			IF (stat_ <> 0) THEN
				log_error_a(LOG_PFIX + 'weld_pkt_srlise err:', stat_)
				-- remote probably disconnected
				stat_ = ssock_dconn2(sock_, sock_fd_)
				-- exit inner loop
				GOTO exit_inner
			ENDIF

			-- sleep a little
			DELAY sleep_time_

		ENDWHILE

		-- 
		exit_inner::
		log_info(LOG_PFIX + 'Disconnected')

	ENDWHILE

	-- 
	exit_discon::
	-- make sure socket is closed
	stat_ = ssock_dconnf(sock_)
	log_info(LOG_PFIX + 'Socket closed')

	-- done
	log_info(LOG_PFIX + 'Welding state relay terminated')

END ros_state_weld_only 