--------------------------------------------------------------------------------
--
-- local types & constants
--
--------------------------------------------------------------------------------

-- Welding message type constant
CONST
	RI_MT_WELDST = 15  -- Welding state message type


-- Welding state structure
TYPE
	weld_state_t = STRUCTURE
		arc_ok         : BOOLEAN  -- I>0, Arc established (from Bit 0 of status word)
		ready          : BOOLEAN  -- Welder is ready (from Bit 1 of status word)
		stick_err      : BOOLEAN  -- Wire stick error (from Bit 2 of status word)  
		power_err      : BOOLEAN  -- Power error (from DI[252] power error)
		depos_di       : BOOLEAN  -- Deposition detection (from DI[251] original value)
		act_voltage    : INTEGER  -- Actual voltage (raw ADC value)
		act_current    : INTEGER  -- Actual current (raw ADC value)
		act_wire_spd   : INTEGER  -- Actual wire speed (raw ADC value)
	ENDSTRUCTURE

-- Complete welding packet structure
TYPE
	ind_weld_t = STRUCTURE
		hdr_       : ind_hdr_t       -- Common header
		weld_data_ : weld_state_t    -- Welding state data
	ENDSTRUCTURE 