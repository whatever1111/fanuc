<?xml version="1.0"?>
<!-- 
  Launch file for testing Fanuc welding state node with debug information
-->
<launch>
  <!-- IP of robot (or PC running simulation) -->
  <arg name="robot_ip" default="192.168.1.31" doc="IP of controller" />
  
  <!-- Port for welding state communication -->
  <arg name="robot_port" default="11002" doc="TCP port for welding state communication" />

  <!-- Enable debug output -->
  <arg name="debug" default="true" doc="Enable debug output" />

  <!-- put parameters on the parameter server -->
  <param name="robot_ip" type="str" value="$(arg robot_ip)" />
  <param name="robot_port" type="int" value="$(arg robot_port)" />

  <!-- launch the welding state node with debug enabled -->
  <node name="fanuc_weld_state_node" pkg="fanuc_driver" type="fanuc_weld_state_node" output="screen">
    <param name="robot_ip" value="$(arg robot_ip)" />
    <param name="robot_port" value="$(arg robot_port)" />
    <rosparam if="$(arg debug)" param="log_level">DEBUG</rosparam>
  </node>

  <!-- Optional: echo the weld state topic to terminal -->
  <node if="$(arg debug)" name="weld_state_echo" pkg="rostopic" type="rostopic" 
        args="echo /weld_state" output="screen" />
</launch> 