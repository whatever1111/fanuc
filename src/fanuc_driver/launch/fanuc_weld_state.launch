<?xml version="1.0"?>
<!-- 
  Launch file for the Fanuc specific welding state node.
  This node connects to the robot on port 11003 and reads welding parameters.
-->
<launch>
  <!-- IP of robot (or PC running simulation) -->
  <arg name="robot_ip" doc="IP of controller" default="192.168.1.31" />

  <!-- Port for welding state communication -->
  <arg name="robot_port" doc="Port for welding state communication" default="11002" />

  <!-- Debug mode for verbose logging -->
  <arg name="debug_mode" doc="Enable debug mode for verbose logging" default="true" />

  <!-- put them on the parameter server -->
  <param name="robot_ip_address" type="str" value="$(arg robot_ip)" />

  <!-- launch the welding state node -->
  <node name="fanuc_weld_state" pkg="fanuc_driver" type="fanuc_weld_state_node" output="screen">
    <param name="robot_ip" type="str" value="$(arg robot_ip)" />
    <param name="robot_port" type="int" value="$(arg robot_port)" />
    <param name="debug_mode" type="bool" value="$(arg debug_mode)" />
  </node>
</launch> 