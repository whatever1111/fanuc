<?xml version="1.0"?>
<launch>
  <!-- Fanuc Welding Control System Launch File -->
  <!-- This launches welding command control only -->
  
  <!-- Arguments -->
  <arg name="robot_ip" default="127.0.0.1" />
  <arg name="robot_port" default="11003" />
  <arg name="debug" default="false" />
  <!-- 消息字节序: little 或 big -->
  <arg name="byte_order" default="little" />
  
  <!-- Weld Command Node -->
  <!-- Subscribes to /weld_command topic and sends commands to robot -->
  <node name="weld_command_sender" pkg="fanuc_driver" type="weld_command_node" output="screen">
    <param name="robot_ip" value="$(arg robot_ip)" />
    <param name="robot_port" value="$(arg robot_port)" />
    <param name="debug" value="$(arg debug)" />
    <param name="byte_order" value="$(arg byte_order)" />
  </node>
  
</launch> 
