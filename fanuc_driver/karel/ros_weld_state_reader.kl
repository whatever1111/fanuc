PROGRAM ros_weld_state_reader
--------------------------------------------------------------------------------
-- 
-- ROS-Industrial welding state reader.
-- 
-- This program reads welding parameters from GI/DI and sends them to ROS.
-- Based on the stable ros_state.kl architecture - ONLY SENDS, NO RECEIVING.
-- 
-- Assumptions:
--   - User Socket Messaging (USM) is supported by robot
--   - EWM welding power source connected via fieldbus
-- 
-- Configuration defaults:
--   - TAG 'S4' used for USM  
--   - Welding state TCP port 11002
-- 
-- author: YOUR_NAME
-- 
--------------------------------------------------------------------------------
%ALPHABETIZE
%COMMENT = 'rwreader'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR


--------------------------------------------------------------------------------
-- 
-- remote types & constants
-- 
--------------------------------------------------------------------------------
%INCLUDE include\libssock_t
%INCLUDE include\libind_hdr_t
%INCLUDE include\libind_pkt_t
%INCLUDE include\libind_weld_t
%INCLUDE include\libind_weld_h


--------------------------------------------------------------------------------
-- 
-- local types & constants
-- 
--------------------------------------------------------------------------------
TYPE
	weld_cfg_t = STRUCTURE
		checked      : BOOLEAN  -- user flagged: config checked
		loop_hz      : INTEGER  -- main loop update rate (in Hz)
		s_tcp_nr     : INTEGER  -- TCP port to listen on
		s_tag_nr     : INTEGER  -- server TAG number to use
		um_clear     : BOOLEAN  -- clear user menu on start
		-- Welding I/O mappings
		volt_gi      : INTEGER  -- GI for actual voltage
		curr_gi      : INTEGER  -- GI for actual current
		arc_di       : INTEGER  -- DI for arc detection
		power_err_di : INTEGER  -- DI for power error
		depos_di     : INTEGER  -- DI for deposition detection
	ENDSTRUCTURE


VAR
	cfg_           IN SHADOW : weld_cfg_t -- configuration
	weld_pkt_out_            : ind_weld_t -- ROS-Industrial welding state packet
	sock_                    : ssock_t    -- server socket instance
	sock_fd_                 : FILE       -- file descriptor associated with server socket
	stat_                    : INTEGER    -- status variable
	sleep_time_              : INTEGER
	shutdwn_req_             : BOOLEAN    -- program abort requested status
	seq_nr_                  : INTEGER    -- sequence number for Simple Message


CONST
	-- 
	LOG_PFIX     = 'RWREAD '

	COND_AH      =    1  -- ABORT handler id

	CFG_OK       =    0  -- config ok
	CFG_NOTDONE  =   -1  -- configuration not checked: user action required

	HOST_CTAG_ER = 67144 -- HOST-144 Comm Tag error
	FILE_ILL_PRM =  2032 -- FILE-032 Illegal parameter
	SEV_ABORT    =    2  -- ABORT severity

	-- Configuration defaults
	WELD_TAG     =    3  -- Server tag
	WELD_TCP_P   = 11002 -- TCP port for welding state
	LOOP_HZ      =   10  -- Main loop freq (Hz)
	
	-- I/O mappings (user defined)
	DEF_VOLT_GI      = 2   -- GI[2] for actual voltage
	DEF_CURR_GI      = 3   -- GI[3] for actual current
	DEF_ARC_DI       = 249 -- DI[249] for arc detection
	DEF_POWER_ERR_DI = 252 -- DI[252] for power error
	DEF_DEPOS_DI     = 251 -- DI[251] for deposition detection


--------------------------------------------------------------------------------
-- 
-- remote routine prototypes
-- 
--------------------------------------------------------------------------------
%INCLUDE include\libssock_h
%INCLUDE include\libind_pkt_h
%INCLUDE include\libind_hdr_h
%INCLUDE include\libind_log_h


--------------------------------------------------------------------------------
-- 
-- local routine prototypes
-- 
--------------------------------------------------------------------------------
ROUTINE check_cfg_(cfg : weld_cfg_t) : INTEGER FROM ros_weld_state_reader
ROUTINE install_ah_ FROM ros_weld_state_reader
ROUTINE remove_ah_ FROM ros_weld_state_reader
ROUTINE iwd_srlise(pkt : ind_weld_t; fdesc : FILE) : INTEGER FROM ros_weld_state_reader


--------------------------------------------------------------------------------
-- 
-- Main program
-- 
--------------------------------------------------------------------------------
BEGIN
	-- check config
	stat_ = check_cfg_(cfg_)
	IF (stat_ <> CFG_OK) THEN
		log_error_a(LOG_PFIX + 'cfg error:', stat_)
		log_error(LOG_PFIX + 'check cfg')
		-- errors with config always force user to log window
		log_force
		POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT)
		RETURN
	ENDIF

	-- 
	stat_        = 0
	sleep_time_  = ROUND(1000.0 / cfg_.loop_hz)
	shutdwn_req_ = FALSE
	seq_nr_      = 0  -- Initialize sequence number

	-- initialise ABORT handler
	install_ah_

	-- enable log output
	IF (cfg_.um_clear) THEN log_clear; ENDIF

	-- init welding state packet
	USING weld_pkt_out_ DO
		-- Standard Simple Message format: msg_type(4) + comm_type(4) + reply_type(4) + seq_nr(4) + payload(32) + CR(1) = 49 bytes
		-- length field contains everything after length field itself
		hdr_.length_     = 49  -- 4+4+4+4+32+1 bytes (everything after length field)
		hdr_.msg_type_   = RI_MT_WELDST
		hdr_.comm_type_  = RI_CT_TOPIC
		hdr_.reply_type_ = RI_RT_INVAL
		-- data is filled in the loop
	ENDUSING

	-- init server socket
	stat_ = ssock_ctor(sock_, cfg_.s_tcp_nr, cfg_.s_tag_nr)
	IF (stat_ <> 0) THEN
		IF (stat_ = TAG_CONF_ERR) THEN
			log_error_a(LOG_PFIX + 'cfg err, TAG idx:', cfg_.s_tag_nr)
		ELSE
			log_error_a(LOG_PFIX + 'ssock_ctor err:', stat_)
		ENDIF
		-- nothing we can do, abort
		POST_ERR(HOST_CTAG_ER, '', 0, SEV_ABORT)
	ENDIF

	-- make sure socket is closed
	-- don't care about result
	stat_ = ssock_dconnf(sock_)

	-- 
	WHILE (NOT shutdwn_req_) DO

		-- inform user
		log_info(LOG_PFIX + 'Waiting for ROS weld state reader')

		-- Ensure any previous client connection is closed before accepting a new one.
		-- This is the key to allowing reconnection.
		stat_ = ssock_dconn2(sock_, sock_fd_)

		-- set socket in 'binary mode' (unformatted)
		-- KAREL Reference Manual, MARRC75KR07091E Rev C, sec 7.3.1
		SET_FILE_ATR(sock_fd_, ATR_UF)

		-- wait for connection
		stat_ = ssock_accpt2(sock_, sock_fd_)
		IF (stat_ <> 0) THEN
			log_error_a(LOG_PFIX + 'sock_accept err:', stat_)
			-- can't continue
			GOTO exit_discon
		ENDIF

		-- inform user
		log_info(LOG_PFIX + 'Connected')

		-- got client, start welding state transmission loop
		WHILE (NOT shutdwn_req_) DO

			-- Read I/O and build welding state packet
			USING weld_pkt_out_.weld_data_ DO
				-- Read analog values from Group Inputs
				act_voltage = GIN[cfg_.volt_gi]   -- GI[2] Raw voltage value
				act_current = GIN[cfg_.curr_gi]   -- GI[3] Raw current value
				
				-- Read digital inputs for boolean states
				-- Use simple true/false logic for now
				arc_ok = DIN[cfg_.arc_di]           -- DI[249] Arc detection
				ready = TRUE                        -- Assume ready for testing
				stick_err = FALSE                   -- No stick error for testing
				general_err = DIN[cfg_.power_err_di] -- DI[252] Power error
				
				-- Set error code based on deposition detection
				IF DIN[cfg_.depos_di] THEN          -- DI[251] Deposition detection
					err_code = 0                    -- Normal deposition
				ELSE
					err_code = 1                    -- No deposition detected
				ENDIF
				
				-- Set wire speed to a default value (not used in new mapping)
				act_wire_spd = 0
			ENDUSING

			-- serialise welding state packet, write to socket
			stat_ = iwd_srlise(weld_pkt_out_, sock_fd_)

			-- check result
			IF (stat_ <> 0) THEN
				log_error_a(LOG_PFIX + 'weld_srlise err:', stat_)
				-- remote probably disconnected
				stat_ = ssock_dconn2(sock_, sock_fd_)
				-- exit inner loop
				GOTO exit_inner
			ENDIF

			-- sleep a little (1/T)
			DELAY sleep_time_

		-- inner WHILE loop
		ENDWHILE

		-- exit with forced disconnect
		exit_discon::
			stat_ = ssock_dconn2(sock_, sock_fd_)

		-- exit inner loop
		exit_inner::
			-- nothing

	-- outer WHILE loop
	ENDWHILE

exit_on_err::
	-- nothing

	-- make sure socket is closed (don't care about result)
	stat_ = ssock_dconnf(sock_)

	-- disable the ABORT handler
	remove_ah_

	-- done
	log_info(LOG_PFIX + 'Exit')

END ros_weld_state_reader


--------------------------------------------------------------------------------
-- 
-- Check and validate welding configuration
-- 
--------------------------------------------------------------------------------
ROUTINE check_cfg_
VAR
	a__ : BOOLEAN
BEGIN
	a__ = FALSE

	-- set defaults for any uninitialised entries
	IF (UNINIT(cfg.loop_hz  )) THEN cfg.loop_hz   = LOOP_HZ      ; a__ = TRUE; ENDIF
	IF (UNINIT(cfg.s_tcp_nr )) THEN cfg.s_tcp_nr  = WELD_TCP_P   ; a__ = TRUE; ENDIF
	IF (UNINIT(cfg.s_tag_nr )) THEN cfg.s_tag_nr  = WELD_TAG     ; a__ = TRUE; ENDIF
	IF (UNINIT(cfg.um_clear )) THEN cfg.um_clear  = TRUE         ; a__ = TRUE; ENDIF
	-- I/O mappings
	IF (UNINIT(cfg.volt_gi     )) THEN cfg.volt_gi      = DEF_VOLT_GI     ; a__ = TRUE; ENDIF
	IF (UNINIT(cfg.curr_gi     )) THEN cfg.curr_gi      = DEF_CURR_GI     ; a__ = TRUE; ENDIF
	IF (UNINIT(cfg.arc_di      )) THEN cfg.arc_di       = DEF_ARC_DI      ; a__ = TRUE; ENDIF
	IF (UNINIT(cfg.power_err_di)) THEN cfg.power_err_di = DEF_POWER_ERR_DI; a__ = TRUE; ENDIF
	IF (UNINIT(cfg.depos_di    )) THEN cfg.depos_di     = DEF_DEPOS_DI    ; a__ = TRUE; ENDIF
	IF (UNINIT(cfg.checked  )) THEN cfg.checked   = FALSE        ; a__ = TRUE; ENDIF

	-- make sure user has checked configuration
	IF ((NOT cfg.checked) OR a__) THEN RETURN (CFG_NOTDONE); ENDIF

	-- all ok
	RETURN (CFG_OK)
END check_cfg_


--------------------------------------------------------------------------------
--
-- Serialise ind_weld_t packet and write to file descriptor in Standard Simple Message format.
--
--------------------------------------------------------------------------------
ROUTINE iwd_srlise
VAR
	bool_int  : INTEGER
	stat__    : INTEGER
BEGIN
	stat__ = 0

	-- Standard Simple Message format (matches ipkt_srlise):
	-- 1. Message length (4 bytes) - length of everything after this field
	-- 2. Message type (4 bytes)
	-- 3. Communication type (4 bytes) 
	-- 4. Reply type (4 bytes)
	-- 5. Sequence number (4 bytes)
	-- 6. Payload (32 bytes)
	-- 7. CR terminator (1 byte)
	-- Total: 4 + 4 + 4 + 4 + 4 + 32 + 1 = 53 bytes (length field = 49)

	-- Write header fields and check status each time
	WRITE fdesc (pkt.hdr_.length_)
	stat__ = IO_STATUS(fdesc)
	IF stat__ <> 0 THEN RETURN (-stat__); ENDIF

	WRITE fdesc (pkt.hdr_.msg_type_)
	stat__ = IO_STATUS(fdesc)
	IF stat__ <> 0 THEN RETURN (-stat__); ENDIF

	WRITE fdesc (pkt.hdr_.comm_type_)
	stat__ = IO_STATUS(fdesc)
	IF stat__ <> 0 THEN RETURN (-stat__); ENDIF

	WRITE fdesc (pkt.hdr_.reply_type_)
	stat__ = IO_STATUS(fdesc)
	IF stat__ <> 0 THEN RETURN (-stat__); ENDIF

	-- Write sequence number (increment for each message)
	seq_nr_ = seq_nr_ + 1
	WRITE fdesc (seq_nr_)
	stat__ = IO_STATUS(fdesc)
	IF stat__ <> 0 THEN RETURN (-stat__); ENDIF

	-- Write weld_state_t payload, converting booleans to integers
	IF pkt.weld_data_.arc_ok THEN bool_int = 1; ELSE bool_int = 0; ENDIF
	WRITE fdesc (bool_int)
	stat__ = IO_STATUS(fdesc)
	IF stat__ <> 0 THEN RETURN (-stat__); ENDIF

	IF pkt.weld_data_.ready THEN bool_int = 1; ELSE bool_int = 0; ENDIF
	WRITE fdesc (bool_int)
	stat__ = IO_STATUS(fdesc)
	IF stat__ <> 0 THEN RETURN (-stat__); ENDIF

	IF pkt.weld_data_.stick_err THEN bool_int = 1; ELSE bool_int = 0; ENDIF
	WRITE fdesc (bool_int)
	stat__ = IO_STATUS(fdesc)
	IF stat__ <> 0 THEN RETURN (-stat__); ENDIF

	IF pkt.weld_data_.general_err THEN bool_int = 1; ELSE bool_int = 0; ENDIF
	WRITE fdesc (bool_int)
	stat__ = IO_STATUS(fdesc)
	IF stat__ <> 0 THEN RETURN (-stat__); ENDIF

	WRITE fdesc (pkt.weld_data_.err_code)
	stat__ = IO_STATUS(fdesc)
	IF stat__ <> 0 THEN RETURN (-stat__); ENDIF

	WRITE fdesc (pkt.weld_data_.act_voltage)
	stat__ = IO_STATUS(fdesc)
	IF stat__ <> 0 THEN RETURN (-stat__); ENDIF

	WRITE fdesc (pkt.weld_data_.act_current)
	stat__ = IO_STATUS(fdesc)
	IF stat__ <> 0 THEN RETURN (-stat__); ENDIF

	WRITE fdesc (pkt.weld_data_.act_wire_spd)
	stat__ = IO_STATUS(fdesc)
	IF stat__ <> 0 THEN RETURN (-stat__); ENDIF

	-- End with CR for Standard Simple Message protocol compliance
	WRITE fdesc (CR)
	stat__ = IO_STATUS(fdesc)

	RETURN (-stat__)
END iwd_srlise


--------------------------------------------------------------------------------
-- 
-- Application handler for ABORT signals.
-- 
--------------------------------------------------------------------------------
ROUTINE ab_hndlr_
BEGIN
	shutdwn_req_ = TRUE
	CANCEL FILE sock_fd_
END ab_hndlr_


--------------------------------------------------------------------------------
-- 
-- Installs a condition handler that catches ABORT signals to allow the
-- application to 'gracefully' exit.
-- 
--------------------------------------------------------------------------------
ROUTINE install_ah_
BEGIN
	CONDITION[COND_AH]: WITH $SCAN_TIME = 256
		WHEN ABORT DO
			NOABORT
			ab_hndlr_
	ENDCONDITION
	ENABLE CONDITION[COND_AH]
END install_ah_


--------------------------------------------------------------------------------
-- 
-- Deregisters the ABORT condition handler.
-- 
--------------------------------------------------------------------------------
ROUTINE remove_ah_
BEGIN
	PURGE CONDITION[COND_AH]
END remove_ah_ 
